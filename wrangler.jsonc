{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mm-control",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "PASSKEYS",
      "id": "1fe4969f85884d708947a511e648a348"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mm-control-db",
      "database_id": "06f9db91-d9ea-4700-9a0b-2c5b8fbf96f4"
    }
  ]
}
